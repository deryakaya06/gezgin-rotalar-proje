rules_version = '2';

// Sprint 1: yalnızca kullanıcı profilleri. Kuralı olmayan her koleksiyon varsayılan olarak kapalıdır.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfileFields(data) {
      return data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 40
        && data.accountType in ['couple', 'friends'];
    }

    // users/{uid}: herkese açık profil. E-posta burada tutulmaz (Firebase Auth'ta kalır).
    match /users/{uid} {
      allow read: if signedIn();

      // Kullanıcı yalnızca kendi profilini, bilinen alanlarla ve puanlar 0 iken oluşturabilir.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'displayName', 'accountType', 'totalPoints', 'visitCount', 'createdAt'
        ])
        && validProfileFields(request.resource.data)
        && request.resource.data.totalPoints == 0
        && request.resource.data.visitCount == 0
        && request.resource.data.createdAt == request.time;

      // Sonradan yalnızca görünen ad ve hesap türü değiştirilebilir; puanlar doğrudan yazılamaz.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'accountType'])
        && validProfileFields(request.resource.data);

      allow delete: if false;
    }
  }
}
